---
interface Props {
  name: "play" | "check" | "lock" | "phone" | "no-cloud" | "hand" | "info";
  class?: string;
}

const { name, class: className } = Astro.props;
---

{name === "play" && (
  <svg class={className ?? "play"} viewBox="0 0 24 24" aria-hidden="true">
    <path fill="currentColor" d="M5 3.5v17L20 12 5 3.5z" />
  </svg>
)}
{name === "check" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 12.5l4.5 4.5L19 7" />
  </svg>
)}
{name === "lock" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="5" y="10" width="14" height="10" rx="2" />
    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
  </svg>
)}
{name === "phone" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="6" y="3" width="12" height="18" rx="3" />
    <path d="M11 17h2" />
  </svg>
)}
{name === "no-cloud" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 18h10a4 4 0 0 0 .4-7.98A5 5 0 0 0 8 9" />
    <path d="M4 4l16 16" />
  </svg>
)}
{name === "hand" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M8 11V5.5a1.5 1.5 0 0 1 3 0V11" />
    <path d="M11 11V4.5a1.5 1.5 0 0 1 3 0V11" />
    <path d="M14 11V6a1.5 1.5 0 0 1 3 0v9a6 6 0 0 1-12 0v-2l-1.5-2a1.2 1.2 0 0 1 1.8-1.6L8 12" />
  </svg>
)}
{name === "info" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 8h.01M11 12h1v5h1" />
  </svg>
)}
