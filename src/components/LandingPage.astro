---
import Icon from "./Icon.astro";
import { copy, type Locale } from "../data/copy";
import { locales, screenshotMeta, site } from "../data/site";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = copy[locale] ?? copy.en;
const localeEntries = Object.entries(locales) as Array<[Locale, (typeof locales)[Locale]]>;

const imagePath = (src: string) => `/${src}`;
const webpPath = (src: string) => `/${src.replace(/\.png$/, ".webp")}`;
const imageKey = (src: string) => src.replace("assets/", "").replace(".png", "") as keyof typeof screenshotMeta;
const privacyIcons = ["phone", "hand", "no-cloud", "lock"] as const;
---

<header class="nav">
  <div class="nav-inner">
    <a href={locales[locale].path} class="brand">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Gamu Baby</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#features">{t.nav.features}</a>
      <a href="#privacy">{t.nav.privacy}</a>
      <a href="#pro">{t.nav.pro}</a>
    </nav>
    <div class="nav-right">
      <nav class="lang-links" aria-label="Language">
        {localeEntries.map(([code, data]) => (
          <a href={data.path} aria-current={code === locale ? "page" : undefined} lang={code}>
            {data.label}
          </a>
        ))}
      </nav>
      <a class="btn btn-primary hide-sm" href={site.playUrl}>
        <Icon name="play" /> {t.nav.get}
      </a>
    </div>
  </div>
</header>

<main id="main">
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="hero-brushes" style="transform: rotate(-5deg)" aria-hidden="true">
            {["r", "s", "l", "b"].map((brush, index) => (
              <div
                class={`brush ${brush}`}
                style={`height:${[42, 38, 44, 36][index]}px;width:${[78, 96, 86, 70][index]}%;top:${[-30, 26, 86, 146][index]}px;left:${[0, -6, 18, 6][index]}%`}
              />
            ))}
          </div>
          <span class="eyebrow" style="position:relative;z-index:2">{t.hero.eyebrow}</span>
          <h1 style="margin-top:18px">{t.hero.h1}</h1>
          <p class="lead">{t.hero.sub}</p>
          <div class="hero-cta-row">
            <a class="btn btn-primary" href={site.playUrl}>
              <Icon name="play" /> {t.hero.primary}
            </a>
            <a class="btn btn-ghost" href="#features">{t.hero.secondary}</a>
          </div>
          <div class="trust" aria-label="Trust strip">
            {t.hero.trust.map((item, index) => (
              <span>
                {index > 0 && <span class="dot" aria-hidden="true"></span>}
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="hero-visual">
          <span class="blob rose" aria-hidden="true"></span>
          <span class="blob sage" aria-hidden="true"></span>
          <div class="phone-stack">
            <div class="phone p1">
              <picture>
                <source srcset="/assets/04-journey.webp" type="image/webp" />
                <img src="/assets/04-journey.png" alt={screenshotMeta["04-journey"].alt} width="1080" height="1780" decoding="async" />
              </picture>
            </div>
            <div class="phone p2">
              <picture>
                <source srcset="/assets/01-milestones.webp" type="image/webp" />
                <img src="/assets/01-milestones.png" alt={screenshotMeta["01-milestones"].alt} width="1080" height="1780" fetchpriority="high" decoding="async" />
              </picture>
            </div>
          </div>
          <div class="chips" aria-hidden="true">
            {[0, 1, 2, 3, 4, 5].map((i) => (
              <span
                class="chip"
                style={`left:${Math.round((i * 173) % 100)}%;top:${Math.round(((i * 91) + 30) % 100)}%;width:${14 + ((i * 7) % 18)}px;height:${14 + ((i * 7) % 18)}px;background:${["#e7c8d0", "#d3decb", "#ddd2e6", "#ece1b5", "#d1e0e8"][i % 5]};transform:rotate(${((i * 47) % 90) - 45}deg)`}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="get-started" style="padding-top:40px">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">{t.first.eyebrow}</span>
        <h2 style="margin-top:14px">{t.first.h2}</h2>
        <p class="lead">{t.first.sub}</p>
      </div>
      <div class="steps">
        {t.first.steps.map((step, index) => (
          <div class="step">
            <div class="step-num">{index + 1}</div>
            <h3>{step.t}</h3>
            <p>{step.d}</p>
            <div class="timing"><span class="timing-dot"></span>{step.time}</div>
          </div>
        ))}
      </div>
      <div class="under-minute">- {t.first.cta}</div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">{t.feat.eyebrow}</span>
        <h2 style="margin-top:14px">{t.feat.h2}</h2>
        <p class="lead">{t.feat.sub}</p>
      </div>
      <div class="features">
        {t.feat.cards.map((card, index) => {
          const klass = ["feat-1", "feat-2", "feat-3", "feat-4", "feat-5", "feat-6", "feat-7", "feat-1"][index];
          const key = card.img ? imageKey(card.img) : null;
          return (
            <article class={`feat ${klass}`}>
              <div class="feat-body">
                <div class="feat-tag">{card.tag}</div>
                <h3>{card.t}</h3>
                <p>{card.d}</p>
                <div class="pill-row">
                  {card.pills.map((pill) => <span class="pill"><span class="sw"></span>{pill}</span>)}
                </div>
              </div>
              {card.img && key && (
                <div class="shot">
                  <picture>
                    <source srcset={webpPath(card.img)} type="image/webp" />
                    <img
                      src={imagePath(card.img)}
                      alt={screenshotMeta[key].alt}
                      width={screenshotMeta[key].width}
                      height={screenshotMeta[key].height}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </div>
              )}
              {!card.img && index === 5 && (
                <div class="shot" style="min-height:340px">
                  <div class="pdf-mock">
                    <span class="stamp">For Dr.</span>
                    <div class="ph-h"></div>
                    <div class="ph-sub"></div>
                    {[0, 1, 2, 3, 4, 5].map((row) => (
                      <div class="row"><span class="dot"></span><span class={row % 3 === 0 ? "ln s" : "ln"}></span></div>
                    ))}
                  </div>
                </div>
              )}
              {!card.img && index === 6 && (
                <div class="shot" style="min-height:340px">
                  <div class="pdf-mock year">
                    <span class="stamp">Year 1</span>
                    <div class="ph-h" style="width:75%"></div>
                    <div class="ph-sub"></div>
                    {[0, 1, 2, 3, 4, 5].map((row) => (
                      <div class="row"><span class="dot"></span><span class={row % 2 === 0 ? "ln" : "ln s"}></span></div>
                    ))}
                  </div>
                </div>
              )}
              {!card.img && index === 7 && (
                <div class="shot" style="min-height:340px">
                  <div class="backup-mock">
                    <div class="h">Backup &amp; restore</div>
                    <div class="opt">
                      <div>
                        <div class="lbl">Export backup</div>
                        <div class="sub">.gamu file · stays on your phone</div>
                      </div>
                      <div class="ic">↓</div>
                    </div>
                    <div class="opt">
                      <div>
                        <div class="lbl">Restore from file</div>
                        <div class="sub">One-tap restore on new device</div>
                      </div>
                      <div class="ic s">↑</div>
                    </div>
                  </div>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="privacy" class="privacy">
    <div class="wrap">
      <div class="privacy-grid">
        <div>
          <span class="eyebrow">{t.privacy.eyebrow}</span>
          <h2 style="margin-top:14px">{t.privacy.h2}</h2>
          <p class="lead" style="margin-top:18px">{t.privacy.sub}</p>
          <div class="priv-list">
            {t.privacy.items.map((item, index) => (
              <div class="priv-item">
                <div class="priv-icon">
                  <Icon name={privacyIcons[index]} />
                </div>
                <div>
                  <div class="ttl">{item.t}</div>
                  <div class="desc">{item.d}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="privacy-visual">
          <div class="lock-card">
            <span class="badge"><Icon name="lock" /> {t.privacy.card.badge}</span>
            <h3>{t.privacy.card.h}</h3>
            <p class="desc">{t.privacy.card.d}</p>
            <div class="meta">
              {t.privacy.card.meta.map((item) => (
                <div class="cell">
                  <div class="k">{item.k}</div>
                  <div class="v">{item.v}</div>
                </div>
              ))}
            </div>
            <div class="never">
              {t.privacy.card.never.map((item) => <div>- <b>{item}</b></div>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="pro" class="pro">
    <div class="wrap">
      <div class="pro-grid">
        <div>
          <span class="eyebrow">{t.pro.eyebrow}</span>
          <h2 style="margin-top:14px">{t.pro.h2}</h2>
          <p class="lead" style="margin-top:18px;color:#d6c8b8">{t.pro.sub}</p>
          <div style="margin-top:28px">
            <a class="btn btn-rose" href={site.playUrl}>
              <Icon name="play" /> {t.pro.cta}
            </a>
          </div>
        </div>
        <div class="price-card">
          <ul class="pro-feat">
            {t.pro.feat.map((item) => <li><Icon name="check" /> <span>{item}</span></li>)}
          </ul>
          <div class="pro-note">{t.pro.note}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="final">
    <div class="wrap" style="position:relative">
      <div style="position:absolute;inset:-30px 0 auto 0;height:200px;pointer-events:none;opacity:.7" aria-hidden="true">
        <div class="hero-brushes" style="transform: rotate(-3deg)">
          {["r", "b", "s", "l"].map((brush, index) => (
            <div
              class={`brush ${brush}`}
              style={`height:${[42, 38, 44, 36][index]}px;width:${[78, 96, 86, 70][index]}%;top:${[0, 40, 80, 120][index]}px;left:${[0, -6, 18, 6][index]}%`}
            />
          ))}
        </div>
      </div>
      <h2 style="position:relative;z-index:2">{t.final.h2}</h2>
      <p class="lead">{t.final.sub}</p>
      <a class="btn btn-primary" href={site.playUrl}>
        <Icon name="play" /> {t.final.primary}
      </a>
      <div class="reass">{t.final.reass}</div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot">
    <div>
      <div class="brand" style="margin-bottom:8px">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>Gamu Baby</span>
      </div>
      <p>{t.foot.tag}</p>
      <p style="margin-top:6px">{t.foot.copy}</p>
      <div class="footer-meta">
        <a href="/privacy/">Privacy</a>
        <a href="/faq/">FAQ</a>
        <a href="/updates/">Updates</a>
        <a href={site.supportEmail}>Support</a>
      </div>
    </div>
    <div class="foot-links">
      <a href={t.foot.moreHref} target="_blank" rel="noopener noreferrer">{t.foot.moreLabel}</a>
    </div>
  </div>
</footer>
